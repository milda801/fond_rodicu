<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_md">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/yearly_fee" android:textAppearance="@style/TextAppearance.Kindergarten.TitleLarge" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/academic_year"><com.google.android.material.textfield.TextInputEditText android:id="@+id/academicYearInput" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/yearly_fee"><com.google.android.material.textfield.TextInputEditText android:id="@+id/yearlyFeeInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/splitFeeSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="@string/split_fee" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/first_half_due_date"><com.google.android.material.textfield.TextInputEditText android:id="@+id/firstHalfDueDateInput" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/second_half_due_date"><com.google.android.material.textfield.TextInputEditText android:id="@+id/secondHalfDueDateInput" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/saveFeeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:text="@string/cloud_backup" android:textAppearance="@style/TextAppearance.Kindergarten.TitleLarge" />
        <TextView android:id="@+id/backupStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_sm" android:lineSpacingExtra="3dp" android:text="@string/automatic_backup_not_configured" android:textAppearance="@style/TextAppearance.Kindergarten.BodyMedium" />
        <com.google.android.material.button.MaterialButton android:id="@+id/backupButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_backup" />
        <com.google.android.material.button.MaterialButton android:id="@+id/disableBackupButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/disable_automatic_backup" />
        <com.google.android.material.button.MaterialButton android:id="@+id/restoreButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/restore_backup" />
    </LinearLayout>
</ScrollView>
